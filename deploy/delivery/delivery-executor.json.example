{
  "role": "delivery-executor",
  "serviceUid": 0, "agentUid": 0, "controllerUid": 0, "operatorUid": 0, "executorUid": 0, "orchestratorUid": 0,
  "installedJarSha256": "REPLACE_WITH_REVIEWED_JAR_SHA256",
  "goOrigin": "https://127.0.0.1:9443",
  "goServerCertificateSha256": "REPLACE_WITH_SERVER_LEAF_DER_SHA256",
  "clientCertificate": "/etc/asep/pki/executor.crt",
  "clientKey": "/var/lib/asep/executor/private/client.key",
  "authorityCa": "/etc/asep/pki/service-server-ca.crt",
  "evidenceRoot": "/var/lib/asep/controller/evidence",
  "baseObjectsRoot": null, "verifierJobsRoot": null,
  "profileSha256": "REPLACE_WITH_APPROVED_PROFILE_SHA256",
  "harnessSha256": "REPLACE_WITH_REVIEWED_HARNESS_SHA256",
  "imageSha256": "REPLACE_WITH_PRELOADED_IMAGE_ID_SHA256",
  "minimumTests": 2, "maximumReceiptAgeSeconds": 300,
  "databaseUrl": "jdbc:postgresql://127.0.0.1:5432/asep",
  "databasePassword": "/var/lib/asep/executor/private/database.password",
  "databaseCa": "/etc/asep/pki/postgres-ca.crt",
  "readCredential": "/var/lib/asep/executor/private/gitlab-read.credential",
  "writeCredential": "/var/lib/asep/executor/private/gitlab-write.credential",
  "enrollmentRoot": "/etc/asep/delivery-enrollment",
  "liveWritesEnabled": false
}
